{
  "name": "enderchest",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:admin": "node --test tests/admin-api.test.mjs",
    "test:storage": "node --test tests/storage-api.test.mjs",
    "test:s3": "node --env-file=docker/.env --import tsx tests/s3-presigned-smoke.mjs",
    "test:unit": "node --import tsx --test tests/parse-upload.test.mjs tests/public-url.test.mjs tests/public-link.test.mjs tests/publish-config.test.mjs tests/request.test.mjs tests/host-status.test.mjs",
    "test:security": "node --test tests/security-api.test.mjs",
